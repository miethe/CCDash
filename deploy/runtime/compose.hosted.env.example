# Required for the worker runtime. Replace with a project id that the workspace
# registry can resolve before you run the hosted smoke flow.
CCDASH_STORAGE_PROFILE=enterprise
CCDASH_DB_BACKEND=postgres
CCDASH_PROJECT_ROOT=/app
CCDASH_POSTGRES_DB=ccdash
CCDASH_POSTGRES_USER=ccdash
CCDASH_POSTGRES_PASSWORD=ccdash
CCDASH_API_BEARER_TOKEN=ccdash-dev-token
# Optional /api/v1 client-surface token (require_v1_auth). SEPARATE from
# CCDASH_API_BEARER_TOKEN above. Default empty == no auth on /api/v1
# (local-trust default); uncomment + set to gate the LAN surface.
# CCDASH_API_TOKEN=
CCDASH_WORKER_PROJECT_ID=REPLACE_WITH_RESOLVABLE_PROJECT_ID
CCDASH_API_PORT=8000
CCDASH_FRONTEND_PORT=3000
# Optional override. When unset, compose derives http://localhost:${CCDASH_FRONTEND_PORT}.
# CCDASH_FRONTEND_ORIGIN=http://localhost:3000
CCDASH_API_UPSTREAM=http://api:8000
CCDASH_WORKER_PROBE_HOST=0.0.0.0
CCDASH_WORKER_PROBE_PORT=9465
CCDASH_TELEMETRY_EXPORT_ENABLED=true
CCDASH_SAM_ENDPOINT=https://telemetry.invalid.example/api/v1/analytics/execution-outcomes
CCDASH_SAM_API_KEY=smoke-api-key
CCDASH_TELEMETRY_ALLOW_INSECURE=false
VITE_CCDASH_API_BASE_URL=/api
# Hosted LLM lane (hosted-llm-anthropic-ica-lane-v1 M2/M3). Optional — uncomment
# to opt in. CCDASH_LLM_EGRESS_CONSENT is the GLOBAL egress-consent switch;
# default "false" is fail-closed and must stay false unless you intend to
# permit off-box calls from the hosted/anthropic naming lanes. Setting it true
# here is NOT sufficient on its own -- the target project's own
# `projects.llm_egress_consent` DB column must ALSO be true. See
# docs/guides/external-api-lan-deployment.md.
# CCDASH_LLM_EGRESS_CONSENT=false
# CCDASH_LLM_SESSION_NAMING_LANE=
# CCDASH_LLM_ANTHROPIC_BASE_URL=https://api.anthropic.com
# CCDASH_LLM_ANTHROPIC_API_KEY=
# Deliberately NO default -- do not set one. Empty == anthropic lane disabled.
# CCDASH_LLM_ANTHROPIC_MODEL=
# CCDASH_LLM_GEMINI_API_KEY=
