{
  "platform": "claude_code",
  "schema_version": 3,
  "thinking": {
    "levels": [
      "low",
      "medium",
      "high"
    ],
    "defaults": {
      "disabled_level": "low"
    },
    "max_token_thresholds": {
      "low_max": 8000,
      "medium_max": 24000
    }
  },
  "entry_fields": {
    "session": [
      "cwd",
      "gitBranch",
      "slug",
      "permissionMode",
      "userType",
      "version"
    ],
    "message": [
      "requestId",
      "sourceToolAssistantUUID",
      "sourceToolUseID",
      "isApiErrorMessage",
      "error"
    ]
  },
  "sidecars": {
    "todos": {
      "dir": "todos",
      "glob": "{session_id}-agent-*.json"
    },
    "tasks": {
      "dir": "tasks/{session_id}",
      "task_glob": "*.json",
      "high_watermark_file": ".highwatermark",
      "lock_file": ".lock"
    },
    "teams": {
      "dir": "teams/{session_id}/inboxes",
      "dir_short": "teams/session-{session_id_short}/inboxes",
      "config_file": "config.json",
      "glob": "*.json"
    },
    "teammate_meta": {
      "file_suffix": ".meta.json",
      "colocated": true,
      "subagent_only": true,
      "fields": ["taskKind", "teamName", "parentAgentId", "spawnDepth"],
      "note": "Co-located with the subagent's own JSONL (same dir, same stem: agent-<hash>.jsonl -> agent-<hash>.meta.json). Most .meta.json files lack the team fields; absence is normal, not an error. parentAgentId points at a sibling subagent's own agent_id (its agent-<hash> filename stem), not the flat subagent_parent_id column."
    },
    "session_env": {
      "dir": "session-env/{session_id}",
      "glob": "*"
    },
    "tool_results": {
      "dir": "tool-results",
      "glob": "*.txt",
      "checksum_sample_limit": 8,
      "max_files": 500
    }
  }
}
