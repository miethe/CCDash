{
  "schema_version": 1,
  "mapping_id": "ccdash.skill_name_to_aos.routing.task_class",
  "mapping_version": "1.2.0",
  "producer": "ccdash",
  "source_field": "sessions.skill_name",
  "taxonomy": {
    "taxonomy_id": "aos.routing.task_class",
    "taxonomy_version": "1.0.0",
    "taxonomy_digest": "sha256:d96a0819b0a3a42d14eccc1421d3146b8364253d975d9d54f4f264d4b6adeaca"
  },
  "unmapped_policy": "_unclassified",
  "external_identifier_policy": "canonical_only",
  "role_discriminator": {
    "field": "sessions.subagent_parent_id",
    "roles": ["orchestrator", "implementer"],
    "predicate": "orchestrator iff the session is referenced as some other session's subagent_parent_id (it parents at least one subagent); implementer otherwise",
    "default_role": "implementer",
    "applies_to": "only rules that declare a `roles` object; every other rule stays keyed on source_field alone and its grain is unchanged",
    "coverage": "total — every session resolves to exactly one role, so no row is left unclassified and there is no remainder bucket. A genuine orchestrator whose child sessions were never ingested reads as implementer; that is the pre-existing attribution for those rows, never a new mis-demotion.",
    "rationale": "source_field alone cannot separate a dual-role skill. Parenting a subagent is the discriminator because it is already recorded per session and is Opus-exclusive in practice."
  },
  "rules": [
